if SHIELD_SOFLE_ERGOMECH_LEFT

config ZMK_KEYBOARD_NAME
    default "Ergomech Sofle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

if ZMK_DISPLAY

# The left OLED adds a cursor-speed row to the normal status screen.
# The right half keeps the built-in peripheral screen.
choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

# The built-in screen implies these. A custom screen has to ask.
config ZMK_WIDGET_BATTERY_STATUS
    default y

config ZMK_WIDGET_OUTPUT_STATUS
    default y

config ZMK_WIDGET_LAYER_STATUS
    default y

config LV_USE_THEME_MONO
    default y

# 12px status icons, 8px layer name and speed. See the status screen.
config LV_FONT_MONTSERRAT_12
    default y

config LV_FONT_MONTSERRAT_8
    default y

choice LV_FONT_DEFAULT
    default LV_FONT_DEFAULT_MONTSERRAT_12
endchoice

endif # ZMK_DISPLAY

endif

if SHIELD_SOFLE_ERGOMECH_LEFT || SHIELD_SOFLE_ERGOMECH_RIGHT

config ZMK_SPLIT
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

# 4096 fits the stock widgets and nothing else. Glyph draws past that
# point come out as static. The left half's speed row is one more label,
# and this default has to apply to that custom screen too: ZMK's own
# default is 4096 only for the built-in screen.
config LV_Z_MEM_POOL_SIZE
    default 8192

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif
